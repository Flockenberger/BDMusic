// What Windows shows in BDMusic.exe's details; the version and author come from Main/Version.h
#include <winresrc.h>
#include "Main/Version.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

VS_VERSION_INFO VERSIONINFO
 FILEVERSION BDMUSIC_VERSION
 PRODUCTVERSION BDMUSIC_VERSION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", BDMUSIC_AUTHOR
            VALUE "FileDescription", "Midi to music file converter for Black Desert Online"
            VALUE "FileVersion", BDMUSIC_VERSION_TEXT
            VALUE "InternalName", "BDMusic"
            VALUE "LegalCopyright", BDMUSIC_AUTHOR
            VALUE "OriginalFilename", "BDMusic.exe"
            VALUE "ProductName", "BDMusic"
            VALUE "ProductVersion", BDMUSIC_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
